# Servidor (produção) -- formato diferente do .env.example (local): só a
# password. DATABASE_URL é construído pelo docker-compose.yml a apontar para
# o hostname interno "db" (rede Docker), não "localhost".
#
# Gerar diretamente no servidor, nunca localmente -- ver DEPLOY.md passo 4.
# Este ficheiro é só o formato; o .env real nunca é commitado (.gitignore).
POSTGRES_PASSWORD=<gerada-no-servidor>

# Password do role dashboard_ro (bot/persistence/migrations/0004_dashboard_readonly_role.sql).
# Também gerada no servidor -- e definida no Postgres com ALTER ROLE depois
# do primeiro `docker compose up` (a migration cria o role sem password; ver
# README.md/DEPLOY.md). Secreto distinto do POSTGRES_PASSWORD de propósito:
# uma fuga desta credencial só expõe leitura, nunca controlo da BD.
DASHBOARD_DB_PASSWORD=<gerada-no-servidor>

# --- Opcionais (docker-compose.yml aplica default seguro se omitidos) ---

# DEBUG liga bot.data.ccxt_source's per-resolution raw-candle logging --
# ruidoso, só para diagnóstico ao vivo. Default: INFO.
# LOG_LEVEL=INFO

# Ver scripts/run_live.py: default RiskLimits (0.05 = 5%) é conservador para
# sizing real; com qty=1.0 placeholder, o "equity" diário é só o P&L de uma
# posição contra uma base de cash-flow que reinicia perto de 0 a cada dia
# UTC -- ruído normal do BTC pode oscilar isso 30-100%+, disparando o
# kill-switch por ruído, não por um problema real (ver PROGRESS.md, incidente
# 2026-07-26). Revisitar quando existir sizing real.
# MAX_DAILY_DRAWDOWN_PCT=0.05
